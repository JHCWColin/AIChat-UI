{
  "name": "aiui",
  "version": "7.0.0-canary.10",
  "description": "AIUI Desktop Application",
  "author": "JHCWColin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable nsis",
    "test": "node --test test/agent-protocol.test.js test/agent-tools.test.js test/tool-call-normalizer.test.js"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.jhcwcolin.aiui",
    "productName": "AIUI",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JHCWColin",
        "repo": "AIChat-UI",
        "releaseType": "release",
        "channel": "latest"
      }
    ],
    "files": [
      "**/*",
      "!test/**",
      "!参考.html"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "favicon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "icon.png",
      "artifactName": "AIUI-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AIUI7.0.0-Canary10-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AIUI7.0.0-Canary10-Setup.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "onnxruntime-web": "^1.27.0",
    "ws": "^8.21.1"
  }
}
