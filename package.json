{
  "name": "aiui",
  "version": "8.2.0",
  "description": "AIUI Desktop Application",
  "author": "JHCWColin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "npm run build:tokenizer",
    "build": "electron-builder --win portable nsis",
    "build:tokenizer": "node build-tokenizer.cjs",
    "test": "node --test test/*.test.js",
    "test:gateway-ui": "electron test/gateway-electron-smoke.js",
    "test:agent-live": "electron test/agent-live-smoke.js"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@huggingface/tokenizers": "^0.2.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.7",
    "gpt-tokenizer": "^4.1.0"
  },
  "build": {
    "appId": "com.jhcwcolin.aiui",
    "productName": "AIUI",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JHCWColin",
        "repo": "AIChat-UI",
        "releaseType": "release",
        "channel": "latest"
      }
    ],
    "files": [
      "**/*",
      "!.claude/**",
      "!.github/**",
      "!test/**",
      "!参考.html",
      "!README.md",
      "!INDEX.md",
      "!package-lock.json",
      "!build-tokenizer.cjs",
      "!tokenizer-entry.js",
      "!screenshot/**",
      "!1.keystore",
      "!*.bat",
      "!*.ps1",
      "!*.zip",
      "!*.tar.*",
      "!*.tmp"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "favicon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "icon.png",
      "artifactName": "AIUI-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AIUI${version}-Release-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AIUI${version}-Release-Setup.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "onnxruntime-web": "^1.27.0",
    "ws": "^8.21.1"
  }
}
