{
  "name": "aiui",
  "version": "6.0.0-release",
  "description": "AIUI Desktop Application",
  "author": "JHCWColin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.jhcwcolin.aiui",
    "productName": "AIUI",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!参考.html"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "favicon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "icon.png",
      "artifactName": "AIUI-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AIUI6.0.0-Release-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AIUI6.0.0-Release-Setup.exe"
    }
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0",
    "ws": "^8.21.1"
  }
}
