{
  "name": "aiui",
  "version": "9.6.2",
  "description": "AIUI Desktop Application",
  "author": "JHCWColin",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "npm run build:tokenizer",
    "build": "electron-builder --win portable nsis",
    "build:tokenizer": "node scripts/build-tokenizer.cjs",
    "test": "node --test src/test/*.test.js",
    "test:api-profiles": "electron src/test/api-profiles-smoke.js",
    "test:gateway-ui": "electron src/test/gateway-electron-smoke.js",
    "test:tokenizer-ui": "electron src/test/tokenizer-rules-smoke.js",
    "test:agent-live": "electron src/test/agent-live-smoke.js"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@huggingface/tokenizers": "^0.2.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.7",
    "gpt-tokenizer": "^4.1.0"
  },
  "build": {
    "appId": "com.jhcwcolin.aiui",
    "productName": "AIUI",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JHCWColin",
        "repo": "AIChat-UI",
        "releaseType": "release",
        "channel": "latest"
      }
    ],
    "files": [
      "**/*",
      "!.claude/**",
      "!.github/**",
      "!.workbuddy-ai/**",
      "!docs/**",
      "!scripts/**",
      "!src/test/**",
      "!参考.html",
      "!README.md",
      "!INDEX.md",
      "!MODEL_SUPPORT.md",
      "!package-lock.json",
      "!src/main/tokenizer-entry.js",
      "!*.keystore",
      "!*.p12",
      "!*.zip",
      "!*.tar.*",
      "!*.tmp",
      "!任务.txt"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icons/favicon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "src/assets/icons/icon.png",
      "artifactName": "AIUI-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AIUI${version}-Release-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AIUI${version}-Release-Setup.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "onnxruntime-web": "^1.27.0",
    "ws": "^8.21.1"
  }
}
